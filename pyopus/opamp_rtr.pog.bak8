  "measures": [
    [
      "gain",
      {
        "analysis": "ac",
        "depends": [],
        "expression": "ndx=m.IatXval(np.abs(scale()), 10.0)[0]\n__result=m.XatI(m.ACmag(m.ACtf(v('out'), v('inp', 'inn'))), ndx)",
        "vector": false,
        "components": "",
        "lower": "40",
        "upper": "",
        "norm": ""
      }
    ],
    [
      "bw",
      {
        "analysis": "ac",
        "depends": [],
        "expression": "m.ACbandwidth(m.ACtf(v('out'), v('inp', 'inn')), scale())",
        "vector": false,
        "components": "",
        "lower": "",
        "upper": "",
        "norm": ""
      }
    ],
    [
      "ugbw",
      {
        "analysis": "ac",
        "depends": [],
        "expression": "m.ACugbw(m.ACtf(v('out'), v('inp', 'inn')), scale())",
        "vector": false,
        "components": "",
        "lower": "",
        "upper": "",
        "norm": ""
      }
    ],
    [
      "pm",
      {
        "analysis": "ac",
        "depends": [],
        "expression": "m.ACphaseMargin(m.ACtf(v('out'), v('inp', 'inn')))",
        "vector": false,
        "components": "",
        "lower": "60",
        "upper": "",
        "norm": ""
      }
    ],
    [
      "idd",
      {
        "analysis": "op",
        "depends": [],
        "expression": "idd=-i('v2')",
        "vector": false,
        "components": "",
        "lower": "",
        "upper": "1e-4",
        "norm": ""
      }
    ],
    [
      "out_op",
      {
        "analysis": "op",
        "depends": [],
        "expression": "__result = v('out') - v('net1')",
        "vector": false,
        "components": "",
        "lower": "-0.05",
        "upper": "0.05",
        "norm": "0.05"
      }
    ],
    [
      "noise",
      {
        "analysis": "noise",
        "depends": [],
        "expression": "try:\n    # 1. Frequenz-Achse abrufen (X-Achse in Hz)\n    freq = scale()\n    \n    # 2. Rauschspektrum abrufen (Y-Achse in V^2/Hz)\n    spec = np.abs(v('inoise_spectrum'))\n    \n    # 3. Fl\u00e4che unter der Kurve berechnen (Neuer NumPy 2.0 Befehl!)\n    total_noise_sq = np.trapezoid(spec, freq)\n    \n    # 4. Wurzel ziehen, um Volt (RMS) zu erhalten\n    __result = float(np.sqrt(total_noise_sq))\n\nexcept Exception as e:\n    print(f\"RAUSCH-FEHLER: {e}\")\n    __result = 1.0",
        "vector": false,
        "components": "",
        "lower": "",
        "upper": "1e-3",
        "norm": ""
      }
    ],
    [
      "thd",
      {
        "analysis": "tran",
        "depends": [],
        "expression": "t = np.asarray(scale())\ny = np.asarray(v('out'))\nf0 = 1e3\nn = 2048\ntt = np.linspace(t[-1] - 2.0/f0, t[-1], n, endpoint=False)\nyy = np.interp(tt, t, y)\nsp = np.abs(np.fft.rfft(yy - np.mean(yy)))\nfund = sp[2]\nharm = np.sqrt(np.sum(sp[4:21:2]**2))\n__result = float(harm/fund)",
        "vector": false,
        "components": "",
        "lower": "",
        "upper": "1e-3",
        "norm": "1e-3"
      }
    ]
  ],
