  "measures": [
    [
      "gain",
      {
        "analysis": "ac",
        "depends": [],
        "expression": "ndx=m.IatXval(np.abs(scale()), 10.0)[0]\n__result=m.XatI(m.ACmag(m.ACtf(v('out'), v('inp', 'inn'))), ndx)",
        "vector": false,
        "components": "",
        "lower": "40",
        "upper": "",
        "norm": ""
      }
    ],
    [
      "bw",
      {
        "analysis": "ac",
        "depends": [],
        "expression": "m.ACbandwidth(m.ACtf(v('out'), v('inp', 'inn')), scale())",
        "vector": false,
        "components": "",
        "lower": "",
        "upper": "",
        "norm": ""
      }
    ],
    [
      "ugbw",
      {
        "analysis": "ac",
        "depends": [],
        "expression": "m.ACugbw(m.ACtf(v('out'), v('inp', 'inn')), scale())",
        "vector": false,
        "components": "",
        "lower": "",
        "upper": "",
        "norm": ""
      }
    ],
    [
      "pm",
      {
        "analysis": "ac",
        "depends": [],
        "expression": "m.ACphaseMargin(m.ACtf(v('out'), v('inp', 'inn')))",
        "vector": false,
        "components": "",
        "lower": "60",
        "upper": "",
        "norm": ""
      }
    ],
    [
      "idd",
      {
        "analysis": "op",
        "depends": [],
        "expression": "idd=-i('v2')",
        "vector": false,
        "components": "",
        "lower": "",
        "upper": "1e-4",
        "norm": ""
      }
    ],
    [
      "out_op",
      {
        "analysis": "op",
        "depends": [],
        "expression": "__result = v('out') - v('net1')",
        "vector": false,
        "components": "",
        "lower": "-0.05",
        "upper": "0.05",
        "norm": "0.05"
      }
    ],
    [
      "noise",
      {
        "analysis": "noise",
        "depends": [],
        "expression": "try:\n    # 1. Frequenz-Achse abrufen (X-Achse in Hz)\n    freq = scale()\n    \n    # 2. Rauschspektrum abrufen (Y-Achse in V^2/Hz)\n    spec = np.abs(v('inoise_spectrum'))\n    \n    # 3. Fl\u00e4che unter der Kurve berechnen (Neuer NumPy 2.0 Befehl!)\n    total_noise_sq = np.trapezoid(spec, freq)\n    \n    # 4. Wurzel ziehen, um Volt (RMS) zu erhalten\n    __result = float(np.sqrt(total_noise_sq))\n\nexcept Exception as e:\n    print(f\"RAUSCH-FEHLER: {e}\")\n    __result = 1.0",
        "vector": false,
        "components": "",
        "lower": "",
        "upper": "1e-3",
        "norm": ""
      }
    ],
    [
      "thd",
      {
        "analysis": "tran",
        "depends": [],
        "expression": "t = np.asarray(scale())\ny = np.asarray(v('out'))\nf0 = 1e3\nn = 2048\ntt = np.linspace(t[-1] - 2.0/f0, t[-1], n, endpoint=False)\nyy = np.interp(tt, t, y)\nsp = np.abs(np.fft.rfft(yy - np.mean(yy)))\nfund = sp[2]\nharm = np.sqrt(np.sum(sp[4:21:2]**2))\n__result = float(harm/fund)",
        "vector": false,
        "components": "",
        "lower": "",
        "upper": "1e-3",
        "norm": "1e-3"
      }
    ],
    [
      "sat_margin",
      {
        "analysis": "op",
        "depends": [],
        "expression": "# Saturation check over every MOSFET in the opamp.\n# Vector names confirmed from a saved op run:\n#   @n.x1.<inst>.nsg13_hv_<type>[vds] and [vdss]   (bare)\n#   i(@n.x1.<inst>.nsg13_hv_<type>[ids])            (current, i()-wrapped)\n# IHP sg13g2 devices are OSDI/PSP103 -> ngspice instance letter 'n', inner\n# instance named n<model>; PSP calls the saturation voltage 'vdss', not 'vdsat'.\n#\n# Two traps, both hit once already:\n#  1) p() returns a 1-ELEMENT VECTOR. float() on an ndim>0 array is deprecated\n#     since NumPy 1.25 and raises on NumPy 2.x -> take .ravel()[0] first.\n#  2) PyOPUS runs this via exec(expr, globals(), locals) with np/p in LOCALS,\n#     so a helper \"def\" here would NOT see np or p. Keep it inline.\nPMOS = ['xb3', 'xb4', 'xb7', 'xm1', 'xm10', 'xm11', 'xm14', 'xm15', 'xm17', 'xm2', 'xm21', 'xm22', 'xm23', 'xm25', 'xm29', 'xm3', 'xm30', 'xm9']\nNMOS = ['xb1', 'xb2', 'xb5', 'xb6', 'xm12', 'xm13', 'xm16', 'xm18', 'xm19', 'xm20', 'xm24', 'xm26', 'xm27', 'xm28', 'xm4', 'xm5', 'xm6', 'xm7', 'xm8']\nIOFF = 1e-9          # A; below this the device counts as off\n\nworst, worst_dev, worst_vds, worst_vdss = 1e9, \"none\", 0.0, 0.0\nchecked, skipped, err = 0, 0, None\nfor dev, mdl in [(d, \"nsg13_hv_pmos\") for d in PMOS] + [(d, \"nsg13_hv_nmos\") for d in NMOS]:\n    path = \"n.x1.\" + dev + \".\" + mdl\n    try:\n        vds  = float(np.asarray(p(path, \"vds\")).ravel()[0])\n        vdss = float(np.asarray(p(path, \"vdss\")).ravel()[0])\n    except Exception as e:\n        if err is None:\n            err = path + \" -> \" + type(e).__name__ + \": \" + str(e)\n        continue\n    # Devices carrying no current are skipped: the rail-to-rail input pairs and\n    # the constant-gm switches are OFF by design over part of the input range.\n    try:\n        if abs(float(np.asarray(p(path, \"ids\")).ravel()[0])) < IOFF:\n            skipped += 1\n            continue\n    except Exception:\n        pass                          # current unavailable -> do not gate\n    checked += 1\n    margin = abs(vds) - abs(vdss)\n    if margin < worst:\n        worst, worst_dev, worst_vds, worst_vdss = margin, dev, vds, vdss\n\nif checked == 0:\n    print(\"SAT: no devices evaluated (%d off). First error: %s\" % (skipped, err))\n    __result = -1.0\nelse:\n    if worst < 0:\n        print(\"SAT: %s out of saturation by %.4f V (vds=%.4f vdss=%.4f); \"\n              \"%d checked, %d off\" % (worst_dev, -worst, worst_vds, worst_vdss,\n                                       checked, skipped))\n    __result = float(worst)\n",
        "vector": false,
        "components": "",
        "lower": "0",
        "upper": "",
        "norm": "0.05"
      }
    ]
  ],
