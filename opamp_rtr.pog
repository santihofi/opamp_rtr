    [
      "noise",
      {
        "analysis": "noise",
        "depends": [],
        "expression": "try:\n    # 1. Frequenz-Achse abrufen (X-Achse in Hz)\n    freq = scale()\n    \n    # 2. Rauschspektrum abrufen (Y-Achse in V^2/Hz)\n    spec = np.abs(v('inoise_spectrum'))\n    \n    # 3. Fl\u00e4che unter der Kurve berechnen (Neuer NumPy 2.0 Befehl!)\n    total_noise_sq = np.trapezoid(spec, freq)\n    \n    # 4. Wurzel ziehen, um Volt (RMS) zu erhalten\n    __result = float(np.sqrt(total_noise_sq))\n\nexcept Exception as e:\n    print(f\"RAUSCH-FEHLER: {e}\")\n    __result = 1.0",
        "vector": false,
        "components": "",
        "lower": "",
        "upper": "1e-3",
        "norm": ""
      }
    ],
    [
      "thd",
      {
        "analysis": "tran",
        "depends": [],
        "expression": "t = np.asarray(scale())\ny = np.asarray(v('out'))\nf0 = 1e3\nn = 2048\ntt = np.linspace(t[-1] - 2.0/f0, t[-1], n, endpoint=False)\nyy = np.interp(tt, t, y)\nsp = np.abs(np.fft.rfft(yy - np.mean(yy)))\nfund = sp[2]\nharm = np.sqrt(np.sum(sp[4:21:2]**2))\n__result = float(harm/fund)",
        "vector": false,
        "components": "",
        "lower": "",
        "upper": "1e-3",
        "norm": "1e-3"
      }
    ],
    [
      "sat_margin",
      {
        "analysis": "op",
        "depends": [],
        "expression": "# Saturation check over every MOSFET in the opamp.\n# Vector names confirmed from a saved op run:\n#   @n.x1.<inst>.nsg13_hv_<type>[vds] and [vdss]   (bare)\n#   i(@n.x1.<inst>.nsg13_hv_<type>[ids])            (current, i()-wrapped)\n# IHP sg13g2 devices are OSDI/PSP103 -> ngspice instance letter 'n', inner\n# instance named n<model>. PSP calls the saturation voltage 'vdss', not 'vdsat'.\n#\n# Two traps, both hit once already:\n#  1) p() returns a 1-ELEMENT VECTOR. float() on an ndim>0 array is deprecated\n#     since NumPy 1.25 and raises on NumPy 2.x -> take .ravel()[0] first.\n#  2) PyOPUS runs this via exec(expr, globals(), locals) with np/p in LOCALS,\n#     so a helper \"def\" here would NOT see np or p. Keep it inline.\n# Six devices are deliberately NOT in these lists, all for the same reason:\n# a rail-to-rail stage has to drive its own nodes into the rails, and the\n# devices sitting on those nodes go into triode there by construction.\n#\n#   XM11 / XM12  class-AB output pair, drains on 'out'\n#   XM3  / XM8   the two input tail current sources, drains on ncmdiff_p/_n\n#   XM30 / XM27  the constant-gm boost mirrors, drains on the same two nodes\n#\n# Measured at mos_ss, vdd 3.2, 100 C, vincm 0.2: ncmdiff_n sits at 0.0213 V,\n# 21 mV above vss, because the NMOS pair has just handed over to the PMOS pair.\n# XM8 therefore has Vds = 0.0213 V against Vdss = 0.1703 V. That is the input\n# stage working, not a sizing error, and it is symmetric: at vincm 3.1 the same\n# happens to XM3 on ncmdiff_p. Requiring saturation there makes the whole\n# requirement set unsatisfiable, which is what stalled the 2026-08-24 run at a\n# cost of 2.91 with every other requirement already met.\n#\n# With these six excluded the worst margin over 24 process/vdd/temp/vincm\n# corners is +0.0770 V (XM19 at mos_ff, 3.2 V, 100 C, vincm 0.2).\n# The consequence of a device in triode is lost gain, and gain, pm and terr_cl\n# already police that.\nPMOS = ['xb3', 'xb4', 'xb7', 'xm1', 'xm10', 'xm14', 'xm15', 'xm17', 'xm2', 'xm21', 'xm22', 'xm23', 'xm25', 'xm29', 'xm9']\nNMOS = ['xb1', 'xb2', 'xb5', 'xb6', 'xm13', 'xm16', 'xm18', 'xm19', 'xm20', 'xm24', 'xm26', 'xm28', 'xm4', 'xm5', 'xm6', 'xm7']\nIOFF = 1e-9          # A; below this the device counts as off\n\nworst, worst_dev, worst_vds, worst_vdss = 1e9, \"none\", 0.0, 0.0\nchecked, skipped, err = 0, 0, None\nfor dev, mdl in [(d, \"nsg13_hv_pmos\") for d in PMOS] + [(d, \"nsg13_hv_nmos\") for d in NMOS]:\n    path = \"n.x1.\" + dev + \".\" + mdl\n    try:\n        vds  = float(np.asarray(p(path, \"vds\")).ravel()[0])\n        vdss = float(np.asarray(p(path, \"vdss\")).ravel()[0])\n    except Exception as e:\n        if err is None:\n            err = path + \" -> \" + type(e).__name__ + \": \" + str(e)\n        continue\n    # Devices carrying no current are skipped: the rail-to-rail input pairs and\n    # the constant-gm switches are OFF by design over part of the input range.\n    try:\n        if abs(float(np.asarray(p(path, \"ids\")).ravel()[0])) < IOFF:\n            skipped += 1\n            continue\n    except Exception:\n        pass                          # current unavailable -> do not gate\n    checked += 1\n    margin = abs(vds) - abs(vdss)\n    if margin < worst:\n        worst, worst_dev, worst_vds, worst_vdss = margin, dev, vds, vdss\n\nif checked == 0:\n    print(\"SAT: no devices evaluated (%d off). First error: %s\" % (skipped, err))\n    __result = -1.0\nelse:\n    if worst < 0:\n        print(\"SAT: %s out of saturation by %.4f V (vds=%.4f vdss=%.4f); \"\n              \"%d checked, %d off\" % (worst_dev, -worst, worst_vds, worst_vdss,\n                                       checked, skipped))\n    __result = float(worst)\n",
        "vector": false,
        "components": "",
        "lower": "0",
        "upper": "",
        "norm": "0.05"
      }
    ],
    [
      "overshoot",
      {
        "analysis": "tran_pulse",
        "depends": [],
        "expression": "# Small-signal step response on tb_opamp_rtr_pulse.spice (unity-gain follower).\n# Rising edge at 1 us, falling at 6 us, 100 mV peak to peak centred on vincm.\n# The transient starts from the dc operating point, so t=0 is already settled.\n# Each settled level is averaged over a window ending 0.1 us before the next\n# edge, so it is taken on a settled waveform and never includes an edge itself.\n# The post window opens 21 us after the edge. It has to be that late: a\n# pole-zero doublet leaves a tail that decays over tens of microseconds, and\n# every quantity below is referenced to this level, so sampling it early\n# biases all of them. Residual at +21 us is under 0.12 percent of the step.\nt = np.asarray(scale())\ny = np.asarray(v('out'))\nT0, T1 = 1e-6, 22e-6\npre  = (t > 0.1e-6) & (t < 0.9e-6)\npost = (t > 21.0e-6) & (t < 21.9e-6)\nlo = float(np.mean(y[pre]))\nhi = float(np.mean(y[post]))\nstep = hi - lo\n\n# Percent of the step by which the response passes its own settled level.\n# A dead amp gives step ~ 0, which would divide by zero: report a large\n# failing number instead so the cost stays finite and keeps a gradient.\nif abs(step) < 1e-4:\n    print('OVERSHOOT: step collapsed to %.3e V, amp not following' % step)\n    __result = 1e3\nelse:\n    seg = (t >= T0) & (t <= T1)\n    __result = float((np.max(y[seg]) - hi) / abs(step) * 100.0)\n",
        "vector": false,
        "components": "",
        "lower": "",
        "upper": "15",
        "norm": "15"
      }
    ],
    [
      "tsettle",
      {
        "analysis": "tran_pulse",
        "depends": [],
        "expression": "# Small-signal step response on tb_opamp_rtr_pulse.spice (unity-gain follower).\n# Rising edge at 1 us, falling at 6 us, 100 mV peak to peak centred on vincm.\n# The transient starts from the dc operating point, so t=0 is already settled.\n# Each settled level is averaged over a window ending 0.1 us before the next\n# edge, so it is taken on a settled waveform and never includes an edge itself.\n# The post window opens 21 us after the edge. It has to be that late: a\n# pole-zero doublet leaves a tail that decays over tens of microseconds, and\n# every quantity below is referenced to this level, so sampling it early\n# biases all of them. Residual at +21 us is under 0.12 percent of the step.\nt = np.asarray(scale())\ny = np.asarray(v('out'))\nT0, T1 = 1e-6, 22e-6\npre  = (t > 0.1e-6) & (t < 0.9e-6)\npost = (t > 21.0e-6) & (t < 21.9e-6)\nlo = float(np.mean(y[pre]))\nhi = float(np.mean(y[post]))\nstep = hi - lo\n\n# Time from the rising edge until |out - settled| stays inside 1 percent of the\n# step. Taken as the LAST excursion outside the band, not the first entry, so\n# ringing that re-crosses the band later is still counted.\n#\n# The band is 1 percent and not 0.1 percent on purpose. The doublet tail sits\n# within a few hundredths of a percent of the 0.1 percent boundary for tens of\n# microseconds, so a 0.1 percent criterion swings between 12 and 25 us on the\n# same waveform depending on microvolt changes in the reference level. That is\n# a discontinuous cost surface. At 1 percent the number is stable and still\n# catches ringing. Steady-state accuracy is covered by terr_cl and gain, which\n# is where it belongs.\nif abs(step) < 1e-4:\n    __result = 1.0\nelse:\n    seg = (t >= T0) & (t <= T1)\n    ts, ys = t[seg], y[seg]\n    bad = np.where(np.abs(ys - hi) > 1e-2 * abs(step))[0]\n    __result = float(ts[bad[-1]] - T0) if len(bad) else 0.0\n",
        "vector": false,
        "components": "",
        "lower": "",
        "upper": "5e-6",
        "norm": "5e-6"
      }
    ],
    [
      "terr_cl",
      {
        "analysis": "tran_pulse",
        "depends": [],
        "expression": "# Small-signal step response on tb_opamp_rtr_pulse.spice (unity-gain follower).\n# Rising edge at 1 us, falling at 6 us, 100 mV peak to peak centred on vincm.\n# The transient starts from the dc operating point, so t=0 is already settled.\n# Each settled level is averaged over a window ending 0.1 us before the next\n# edge, so it is taken on a settled waveform and never includes an edge itself.\n# The post window opens 21 us after the edge. It has to be that late: a\n# pole-zero doublet leaves a tail that decays over tens of microseconds, and\n# every quantity below is referenced to this level, so sampling it early\n# biases all of them. Residual at +21 us is under 0.12 percent of the step.\nt = np.asarray(scale())\ny = np.asarray(v('out'))\nT0, T1 = 1e-6, 22e-6\npre  = (t > 0.1e-6) & (t < 0.9e-6)\npost = (t > 21.0e-6) & (t < 21.9e-6)\nlo = float(np.mean(y[pre]))\nhi = float(np.mean(y[post]))\nstep = hi - lo\n\n# Closed-loop tracking error: |out - inp| at both settled levels, worst of the\n# two. E1 has gain 1, so v('inp') is the ideal follower target. This is the\n# requirement itself, measured on a real follower with no loop-break network.\nu = np.asarray(v('inp'))\n__result = float(max(abs(lo - float(np.mean(u[pre]))),\n                     abs(hi - float(np.mean(u[post])))))\n",
        "vector": false,
        "components": "",
        "lower": "",
        "upper": "2e-3",
        "norm": "2e-3"
      }
    ]
  ],
