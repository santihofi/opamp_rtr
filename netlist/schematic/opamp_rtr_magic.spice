XXB3 vbias_p vbias_p vdd vdd sg13_hv_pmos w={w_bias_p} l={l_bias} ng={n_bias_p} m=1 mm_ok=1
XC3 out net5 cap_cmomf w=13.5e-6 l=21e-6 mmin=1 mmax=4 subblock=0 m=1 mm_ok=1
XC2 out net6 cap_cmomf w=13.5e-6 l=21e-6 mmin=1 mmax=4 subblock=0 m=1 mm_ok=1
XR4 net5 out1_n vss rhigh w=1e-6 l=36e-6 m=1 b=0 mm_ok=1
XR2 net6 out1_p vss rhigh w=1e-6 l=36e-6 m=1 b=0 mm_ok=1
XDUMMY1 ncmdiff_n ncmdiff_n ncmdiff_n vss sg13_hv_nmos w=5u l=0.45u ng=4 m=1 mm_ok=1
XDUMMY2 ncmdiff_n ncmdiff_n ncmdiff_n vss sg13_hv_nmos w=5u l=0.45u ng=2 m=1 mm_ok=1
XDUMMY10 out1_n out1_n out1_n vdd sg13_hv_pmos w=15u l=1u ng=2 m=1 mm_ok=1
XDUMMY11 out1_p out1_p out1_p vss sg13_hv_nmos w=5u l=1u ng=2 m=1 mm_ok=1
XRDUMMY vss vss vss rhigh w=1e-6 l=9e-6 m=2 b=0 mm_ok=1
XDUMMY3 ncmdiff_p ncmdiff_p ncmdiff_p ncmdiff_p sg13_hv_pmos w=15u l=0.4u ng=4 m=1 mm_ok=1
